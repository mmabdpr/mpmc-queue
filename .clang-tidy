# Correctness, concurrency, security, performance, and portability checks.
# Formatting and naming are handled by clang-format.
#
# Disabled checks:
# - portability-avoid-pragma-once: all supported compilers implement it.
# - performance-enum-size: public enums keep an int-compatible ABI.
# - clang-analyzer-optin.performance.Padding: cache-line isolation is
#   intentional and the analyzer cannot account for it.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  performance-*,
  portability-*,
  modernize-use-bool-literals,
  modernize-use-emplace,
  modernize-use-nullptr,
  modernize-use-override,
  -portability-avoid-pragma-once,
  -performance-enum-size,
  -clang-analyzer-optin.performance.Padding
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(include/mpmc|tests)/.*'
FormatStyle: file
