{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Release",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MPMC_BUILD_TESTS": "ON",
        "MPMC_BUILD_EXAMPLES": "ON",
        "MPMC_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MPMC_BUILD_TESTS": "ON",
        "MPMC_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "Address/UB sanitizer",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "MPMC_BUILD_TESTS": "ON",
        "MPMC_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "tsan",
      "displayName": "Thread sanitizer",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "MPMC_BUILD_TESTS": "ON",
        "MPMC_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "portable8",
      "displayName": "Portable 8-byte cells",
      "binaryDir": "${sourceDir}/build/portable8",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MPMC_FORCE_8_BYTE_CELLS": "ON",
        "MPMC_BUILD_TESTS": "ON",
        "MPMC_BUILD_EXAMPLES": "ON",
        "MPMC_BUILD_BENCHMARKS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "portable8",
      "configurePreset": "portable8"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "portable8",
      "configurePreset": "portable8",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
